<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — AuditHistory.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <data name="AuditHistory_Name" xml:space="preserve">
    <value>Audit History</value>
  </data>
  <data name="AuditHistory_Desc" xml:space="preserve">
    <value>A record's audit history on the form: who changed what, when, and the old value beside the new.</value>
  </data>
  <data name="value_Name" xml:space="preserve">
    <value>Column</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>Any column of the record. The control never reads or writes it; with Only this column on, the list narrows to changes of this column.</value>
  </data>
  <data name="columnScope_Name" xml:space="preserve">
    <value>Only this column</value>
  </data>
  <data name="columnScope_Desc" xml:space="preserve">
    <value>On: list only changes to the bound column. Off: every audited change to the record.</value>
  </data>
  <data name="showRestore_Name" xml:space="preserve">
    <value>Show Restore</value>
  </data>
  <data name="showRestore_Desc" xml:space="preserve">
    <value>On: each value of an Update can be put back with a Restore button, after a confirmation. Off: the history is read-only.</value>
  </data>
  <data name="pageSize_Name" xml:space="preserve">
    <value>Page size</value>
  </data>
  <data name="pageSize_Desc" xml:space="preserve">
    <value>Changes fetched per page and per Load more, 1 to 100. Each change costs one request for its old and new values.</value>
  </data>
  <data name="recordId_Name" xml:space="preserve">
    <value>Record id</value>
  </data>
  <data name="recordId_Desc" xml:space="preserve">
    <value>Bind to the record’s own id column when the host does not supply the record. A model-driven form supplies it.</value>
  </data>
  <data name="recordEntity_Name" xml:space="preserve">
    <value>Record table</value>
  </data>
  <data name="recordEntity_Desc" xml:space="preserve">
    <value>The table’s logical name, for example account, when the host does not supply the record.</value>
  </data>
  <data name="sampleData_Name" xml:space="preserve">
    <value>Sample data (demo only)</value>
  </data>
  <data name="sampleData_Desc" xml:space="preserve">
    <value>A JSON history rendered instead of the record’s. Leave blank on a real form.</value>
  </data>
  <data name="AuditHistory_NoAccess" xml:space="preserve">
